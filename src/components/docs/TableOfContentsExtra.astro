---
import { Icon } from "astro-icon/components";
---

<section
  class="h-[calc((100vh-5.25rem)*0.33)] overflow-y-hidden rounded-lg bg-linear-to-br from-blue-500 to-indigo-600 p-6 text-white"
>
  <div class="flex h-full flex-col items-center justify-center gap-2 text-center">
    <Icon name="document" class="size-8 opacity-90" />
    <p class="m-0 text-base font-semibold">DataHub</p>
    <p class="m-0 text-xs opacity-80">Gestión de conocimiento y notas personales.</p>
  </div>
</section>
